{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "observatorio-ml",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./docs",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/*"
    ]
  },
  "main": "./worker/index.js",
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "observatorio-ml-db",
      "database_id": "b72c5e4b-9117-4a26-a906-bb3203e01d4a"
    }
  ]
}
