{
  "name": "Observatório ML — Ofertas e Conteúdo",
  "short_name": "Observatório ML",
  "description": "Ranking de ofertas e kits de conteúdo para Veo e Instagram",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "background_color": "#0b1019",
  "theme_color": "#0b1019",
  "icons": [
    {
      "src": "./icon.svg",
      "sizes": "any",
      "type": "image/svg+xml",
      "purpose": "any"
    }
  ],
  "share_target": {
    "action": "./shared",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url",
      "files": [
        {
          "name": "files",
          "accept": [
            "text/html",
            ".html",
            ".htm",
            "text/csv",
            ".csv",
            "application/json",
            ".json"
          ]
        }
      ]
    }
  }
}
