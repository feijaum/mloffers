# Nunca coloque valores reais neste arquivo.
# Segredos devem ser configurados como secrets/variáveis protegidas no ambiente de execução.

# Nome reservado para futura chave de criptografia de tokens armazenados.
INSTAGRAM_TOKEN_ENCRYPTION_KEY=

# Reservado para futura necessidade de segredo adicional de sessão.
SESSION_SECRET=

# Senha do usuário ADM. Configure somente como Secret no Cloudflare.
ADMIN_PASSWORD=

# Token de acesso gerado no painel da API do Instagram.
INSTAGRAM_ACCESS_TOKEN=

# Chave secreta do aplicativo Meta. Configure somente como Secret.
META_APP_SECRET=

# Token usado pela Meta para verificar a URL de callback.
META_WEBHOOK_VERIFY_TOKEN=
