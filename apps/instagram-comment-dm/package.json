{
  "name": "instagram-comment-dm",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "npm run build && vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "deploy": "npm run db:migrate:remote && npm run build && wrangler deploy",
    "db:migrate:local": "wrangler d1 migrations apply instagram_comment_dm --local",
    "db:migrate:remote": "wrangler d1 migrations apply instagram_comment_dm --remote"
  },
  "dependencies": {
    "@vitejs/plugin-react": "latest",
    "react": "latest",
    "react-dom": "latest",
    "zod": "latest"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "latest",
    "@eslint/js": "latest",
    "@types/node": "latest",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "eslint": "latest",
    "typescript": "latest",
    "typescript-eslint": "latest",
    "vite": "latest",
    "wrangler": "latest"
  }
}
