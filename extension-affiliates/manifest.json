{
  "manifest_version": 3,
  "name": "Observatório ML — Links de Afiliado",
  "version": "1.1.1",
  "description": "Associa links oficiais de afiliado aos 20 primeiros produtos do ranking Observatório ML, sob comando do usuário.",
  "permissions": [
    "tabs",
    "storage"
  ],
  "host_permissions": [
    "https://www.mercadolivre.com.br/*",
    "https://produto.mercadolivre.com.br/*",
    "https://feijaum.github.io/*",
    "https://*.pages.dev/*",
    "https://observatorio-ml.jvleite7.workers.dev/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://feijaum.github.io/mloffers/*",
        "https://*.pages.dev/*",
        "https://observatorio-ml.jvleite7.workers.dev/*"
      ],
      "js": [
        "dashboard.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://www.mercadolivre.com.br/*",
        "https://produto.mercadolivre.com.br/*"
      ],
      "js": [
        "product.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "Links de afiliado: use o botão no Observatório ML"
  },
  "minimum_chrome_version": "114"
}
